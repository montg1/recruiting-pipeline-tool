# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/recruiting_db

# LLM provider for Module 1 AI (parse_jd + rank):
#   "anthropic" — FastAPI calls Claude directly (needs ANTHROPIC_API_KEY)
#   "ollama"    — local model, no API key (for testing; needs Ollama running)
#   "n8n"       — delegate AI to the n8n workflow (n8n owns the prompts + Claude call)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# When LLM_PROVIDER=ollama (requires a local Ollama server + the model pulled):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# When LLM_PROVIDER=n8n — webhook of the imported Module1_AI_Workflow:
N8N_AI_WEBHOOK_URL=https://<your-n8n>/webhook/recruitpipe-ai

# Module 1 — Candidate discovery
ZENROWS_API_KEY=your_zenrows_key   # ZenRows Universal API key (LinkedIn X-ray + deep profile fetch)
GITHUB_TOKEN=                      # optional — raises GitHub API rate limit (60 -> 5000/hr)

# Google Calendar
GOOGLE_CREDENTIALS_PATH=credentials.json

# n8n Automation Service
N8N_WEBHOOK_URL=http://localhost:5678/webhook
