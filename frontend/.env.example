# VITE_API_URL is the base URL for the FastAPI backend.
# If you are using Vercel rewrites (via vercel.json), you can leave this empty or commented out,
# and it will default to '/api', which will be routed by Vercel to your backend.
# For local development without proxy, or to bypass the Vercel rewrite, provide the full URL:
# VITE_API_URL=https://your-fastapi-backend-url.onrender.com/api

# For local development with Vite proxy (vite.config.js handles /api), keep it as /api or leave it blank:
VITE_API_URL=/api
