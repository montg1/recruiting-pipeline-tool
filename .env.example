# ==============================================================
# Environment Variables Example for Recruiting Pipeline Tool
# ==============================================================

# 1. Database Connection (Supabase)
# For Supabase, go to Project Settings -> Database -> Connection string -> URI
# NOTE: If using serverless environments (Vercel/Render), use the Connection Pooler URL (port 6543).
# If migrating schema or connecting locally via script, use the Direct Connection URL (port 5432).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. n8n Scraper Webhook URL
# This is the external webhook that parses LinkedIn URLs or resume text.
N8N_WEBHOOK_URL="https://[YOUR-N8N-DOMAIN]/webhook/parse-candidate"

# 3. Claude AI (Module 2 - Resume Scoring)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# 4. Google Calendar API (Module 4 - Interviews)
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
GOOGLE_REFRESH_TOKEN="..."
